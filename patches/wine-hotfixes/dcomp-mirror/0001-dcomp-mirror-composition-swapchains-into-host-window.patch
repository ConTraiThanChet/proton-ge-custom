+static HRESULT STDMETHODCALLTYPE visual_AddVisual(IDCompositionVisual *iface, IDCompositionVisual *child,
+        BOOL insert_above, IDCompositionVisual *reference)
+{
+    struct visual *visual = impl_from_IDCompositionVisual(iface);
+    struct visual *child_impl = impl_from_IDCompositionVisual(child);
+    struct visual **children;
+
+    TRACE("iface %p, child %p, insert_above %d, reference %p.\n", iface, child, insert_above, reference);
+
+    if (!child_impl) return E_INVALIDARG;
+    if (visual->child_count == visual->child_size)
+    {
+        unsigned int size = max(4, visual->child_size * 2);
+        if (!(children = realloc(visual->children, size * sizeof(*children)))) return E_OUTOFMEMORY;
+        visual->children = children;
+        visual->child_size = size;
+    }
+    IDCompositionVisual_AddRef(child);
+    visual->children[visual->child_count++] = child_impl;
+    return S_OK;
+}
