+/*
+ * Minimal DirectComposition "mirror": a swapchain set as content of a visual
+ * attached to an HWND target is drawn into the HWND swapchain of the same
+ * top-level window right before that one is presented, which is what DWM
+ * would show on Windows. Needs DXVK's dxgi.enableDummyCompositionSwapchain.
+ *
+ * Only enabled for known applications or with WINE_DCOMP_MIRROR=1, since
+ * other applications are better off with DCompositionCreateDevice failing.
+ */
+
+#define COBJMACROS
 #include <stdarg.h>
+#include <stdlib.h>
 
