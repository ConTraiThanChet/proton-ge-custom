-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* not part of libuuid */
+static const GUID iid_device = {0xc37ea93a, 0xe7aa, 0x450d, {0xb1, 0x6f, 0x97, 0x46, 0xcb, 0x04, 0x07, 0xf3}};
+static const GUID iid_target = {0xeacdd04c, 0x117e, 0x4e17, {0x88, 0xf4, 0xd1, 0xb1, 0x2b, 0x0e, 0x3d, 0x89}};
+static const GUID iid_visual = {0x4d93059d, 0x097b, 0x4651, {0x9a, 0x60, 0xf0, 0xf2, 0x51, 0x16, 0xe2, 0xf3}};
+
+static CRITICAL_SECTION mirror_cs;
+static CRITICAL_SECTION_DEBUG mirror_cs_debug =
+{
+    0, 0, &mirror_cs,
+    { &mirror_cs_debug.ProcessLocksList, &mirror_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mirror_cs") }
+};
+static CRITICAL_SECTION mirror_cs = { &mirror_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL mirror_enabled(void)
+{
+    static const WCHAR *apps[] = { L"nshm.exe" };
+    const WCHAR *env = _wgetenv(L"WINE_DCOMP_MIRROR");
+    WCHAR path[MAX_PATH], *name;
+    unsigned int i;
+
+    if (env) return *env && *env != '0';
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return FALSE;
+    name = wcsrchr(path, '\\');
+    name = name ? name + 1 : path;
+    for (i = 0; i < ARRAY_SIZE(apps); ++i)
+        if (!wcsicmp(name, apps[i])) return TRUE;
+    return FALSE;
+}
