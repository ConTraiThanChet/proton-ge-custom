+/* ---------------- mirrors ---------------- */
+
+struct mirror
+{
+    struct list entry;
+    IDXGISwapChain1 *src;
+    HWND target;
+    BOOL skip_present;
+    DWORD last_tick;
+    unsigned int frames, composited;
+    BOOL failed;
+    /* written by the producer device, opened on the consumer device */
+    ID3D11Texture2D *shared_src;
+    HANDLE shared_handle;
+    ID3D11Texture2D *shared_dst;
+    HANDLE opened_handle;
+};
+
+static struct list mirrors = LIST_INIT(mirrors);
+
+typedef HRESULT (STDMETHODCALLTYPE *present_func)(IDXGISwapChain *, UINT, UINT);
+typedef HRESULT (STDMETHODCALLTYPE *present1_func)(IDXGISwapChain1 *, UINT, UINT, const DXGI_PRESENT_PARAMETERS *);
+static present_func orig_present;
+static present1_func orig_present1;
+
+static HANDLE window_present_event;
+static DWORD window_present_tid;
+
+/* must be called with mirror_cs held */
+static struct mirror *find_mirror(void *swapchain)
+{
+    struct mirror *m;
+
+    LIST_FOR_EACH_ENTRY(m, &mirrors, struct mirror, entry)
+        if ((void *)m->src == swapchain) return m;
+    return NULL;
+}
