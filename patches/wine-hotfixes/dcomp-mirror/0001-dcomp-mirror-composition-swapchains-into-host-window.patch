+/* ---------------- blitter ---------------- */
+
+static const char blit_hlsl[] =
+    "Texture2D t : register(t0);\n"
+    "SamplerState s : register(s0);\n"
+    "void vs(uint id : SV_VertexID, out float4 pos : SV_Position, out float2 uv : TEXCOORD0)\n"
+    "{ uv = float2((id << 1) & 2, id & 2); pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); }\n"
+    "float4 ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target\n"
+    "{ float3 c = t.Sample(s, uv).rgb;\n"
+    "#ifdef LINEAR_OUT\n"
+    "  c = c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);\n"
+    "#endif\n"
+    "  return float4(c, 1); }\n";
+
+typedef HRESULT (WINAPI *d3dcompile_func)(const void *, SIZE_T, const char *, const D3D_SHADER_MACRO *,
+        ID3DInclude *, const char *, const char *, UINT, UINT, ID3DBlob **, ID3DBlob **);
+
+static struct
+{
+    ID3D11Device *device; /* not referenced, identity only */
+    BOOL failed;
+    ID3DDeviceContextState *state;
+    ID3D11VertexShader *vs;
+    ID3D11PixelShader *ps[2];
+    ID3D11SamplerState *sampler;
+    ID3D11Texture2D *tmp;
+    ID3D11ShaderResourceView *srv;
+    D3D11_TEXTURE2D_DESC tmp_desc;
+    ID3D11Texture2D *rtv_texture; /* not referenced, identity only */
+    ID3D11RenderTargetView *rtv;
+} blitter;
+
+static ID3DBlob *compile_shader(d3dcompile_func d3dcompile, const char *entry, const char *profile, BOOL linear)
+{
+    static const D3D_SHADER_MACRO defines[] = {{"LINEAR_OUT", "1"}, {NULL, NULL}};
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+
+    hr = d3dcompile(blit_hlsl, sizeof(blit_hlsl) - 1, "dcomp_blit", linear ? defines : NULL, NULL,
+            entry, profile, 0, 0, &code, &errors);
+    if (FAILED(hr))
+        ERR("Failed to compile %s, hr %#lx, %s.\n", entry, hr,
+                errors ? debugstr_a(ID3D10Blob_GetBufferPointer(errors)) : "");
+    if (errors) ID3D10Blob_Release(errors);
+    return code;
+}
+
+static BOOL blitter_init(ID3D11Device *device)
+{
+    D3D11_SAMPLER_DESC sampler_desc = {0};
+    ID3DBlob *vs = NULL, *ps0 = NULL, *ps1 = NULL;
+    d3dcompile_func d3dcompile = NULL;
+    D3D_FEATURE_LEVEL feature_level;
+    ID3D11Device1 *device1;
+    HMODULE module;
+    BOOL ok;
+
+    if (blitter.device == device) return !blitter.failed;
+
+    if (blitter.state) ID3DDeviceContextState_Release(blitter.state);
+    if (blitter.vs) ID3D11VertexShader_Release(blitter.vs);
+    if (blitter.ps[0]) ID3D11PixelShader_Release(blitter.ps[0]);
+    if (blitter.ps[1]) ID3D11PixelShader_Release(blitter.ps[1]);
+    if (blitter.sampler) ID3D11SamplerState_Release(blitter.sampler);
+    if (blitter.srv) ID3D11ShaderResourceView_Release(blitter.srv);
+    if (blitter.tmp) ID3D11Texture2D_Release(blitter.tmp);
+    if (blitter.rtv) ID3D11RenderTargetView_Release(blitter.rtv);
+    memset(&blitter, 0, sizeof(blitter));
+    blitter.device = device;
+    blitter.failed = TRUE;
+
+    if ((module = LoadLibraryW(L"d3dcompiler_47.dll")))
+        d3dcompile = (d3dcompile_func)GetProcAddress(module, "D3DCompile");
+    if (!d3dcompile)
+    {
+        ERR("D3DCompile is not available.\n");
+        return FALSE;
+    }
+
+    vs = compile_shader(d3dcompile, "vs", "vs_4_0", FALSE);
+    ps0 = compile_shader(d3dcompile, "ps", "ps_4_0", FALSE);
+    ps1 = compile_shader(d3dcompile, "ps", "ps_4_0", TRUE);
+    ok = vs && ps0 && ps1
+            && SUCCEEDED(ID3D11Device_CreateVertexShader(device, ID3D10Blob_GetBufferPointer(vs),
+                    ID3D10Blob_GetBufferSize(vs), NULL, &blitter.vs))
+            && SUCCEEDED(ID3D11Device_CreatePixelShader(device, ID3D10Blob_GetBufferPointer(ps0),
+                    ID3D10Blob_GetBufferSize(ps0), NULL, &blitter.ps[0]))
+            && SUCCEEDED(ID3D11Device_CreatePixelShader(device, ID3D10Blob_GetBufferPointer(ps1),
+                    ID3D10Blob_GetBufferSize(ps1), NULL, &blitter.ps[1]));
+    if (vs) ID3D10Blob_Release(vs);
+    if (ps0) ID3D10Blob_Release(ps0);
+    if (ps1) ID3D10Blob_Release(ps1);
+
+    sampler_desc.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler_desc.AddressU = sampler_desc.AddressV = sampler_desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sampler_desc.MaxLOD = D3D11_FLOAT32_MAX;
+    ok = ok && SUCCEEDED(ID3D11Device_CreateSamplerState(device, &sampler_desc, &blitter.sampler));
+
+    if (ok && SUCCEEDED(ID3D11Device_QueryInterface(device, &IID_ID3D11Device1, (void **)&device1)))
+    {
+        feature_level = ID3D11Device_GetFeatureLevel(device);
+        ok = SUCCEEDED(ID3D11Device1_CreateDeviceContextState(device1, 0, &feature_level, 1,
+                D3D11_SDK_VERSION, &IID_ID3D11Device1, NULL, &blitter.state));
+        ID3D11Device1_Release(device1);
+    }
+    else
+    {
+        ok = FALSE;
+    }
+
+    TRACE("Blitter for device %p, ok %d.\n", device, ok);
+    blitter.failed = !ok;
+    return ok;
+}
+
+static BOOL needs_linear_output(DXGI_FORMAT format)
+{
+    return format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB
+            || format == DXGI_FORMAT_B8G8R8X8_UNORM_SRGB || format == DXGI_FORMAT_R16G16B16A16_FLOAT;
+}
+
+static void blit(ID3D11Device *device, ID3D11DeviceContext *context, ID3D11Texture2D *src, ID3D11Texture2D *dst)
+{
+    ID3D11ShaderResourceView *null_srv = NULL;
+    ID3DDeviceContextState *prev = NULL;
+    D3D11_TEXTURE2D_DESC src_desc, dst_desc;
+    ID3D11DeviceContext1 *context1;
+    D3D11_VIEWPORT vp;
+
+    if (!blitter_init(device)) return;
+
+    ID3D11Texture2D_GetDesc(src, &src_desc);
+    ID3D11Texture2D_GetDesc(dst, &dst_desc);
+
+    if (!blitter.tmp || blitter.tmp_desc.Width != src_desc.Width || blitter.tmp_desc.Height != src_desc.Height
+            || blitter.tmp_desc.Format != src_desc.Format)
+    {
+        D3D11_TEXTURE2D_DESC desc = {0};
+
+        if (blitter.srv) ID3D11ShaderResourceView_Release(blitter.srv);
+        if (blitter.tmp) ID3D11Texture2D_Release(blitter.tmp);
+        blitter.srv = NULL;
+        blitter.tmp = NULL;
+
+        desc.Width = src_desc.Width;
+        desc.Height = src_desc.Height;
+        desc.MipLevels = 1;
+        desc.ArraySize = 1;
+        desc.Format = src_desc.Format;
+        desc.SampleDesc.Count = 1;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(ID3D11Device_CreateTexture2D(device, &desc, NULL, &blitter.tmp))
+                || FAILED(ID3D11Device_CreateShaderResourceView(device, (ID3D11Resource *)blitter.tmp,
+                        NULL, &blitter.srv)))
+        {
+            ERR("Failed to create intermediate texture.\n");
+            blitter.failed = TRUE;
+            return;
+        }
+        blitter.tmp_desc = desc;
+    }
+
+    if (blitter.rtv_texture != dst)
+    {
+        if (blitter.rtv) ID3D11RenderTargetView_Release(blitter.rtv);
+        blitter.rtv = NULL;
+        blitter.rtv_texture = NULL;
+        if (FAILED(ID3D11Device_CreateRenderTargetView(device, (ID3D11Resource *)dst, NULL, &blitter.rtv)))
+        {
+            ERR("Failed to create RTV for format %#x.\n", dst_desc.Format);
+            return;
+        }
+        blitter.rtv_texture = dst;
+        TRACE("Target %ux%u format %#x, source %ux%u format %#x.\n", dst_desc.Width, dst_desc.Height,
+                dst_desc.Format, src_desc.Width, src_desc.Height, src_desc.Format);
+    }
+
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)blitter.tmp, (ID3D11Resource *)src);
+
+    if (FAILED(ID3D11DeviceContext_QueryInterface(context, &IID_ID3D11DeviceContext1, (void **)&context1)))
+        return;
+    ID3D11DeviceContext1_SwapDeviceContextState(context1, blitter.state, &prev);
+
+    vp.TopLeftX = vp.TopLeftY = 0.0f;
+    vp.Width = dst_desc.Width;
+    vp.Height = dst_desc.Height;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+    ID3D11DeviceContext1_OMSetRenderTargets(context1, 1, &blitter.rtv, NULL);
+    ID3D11DeviceContext1_RSSetViewports(context1, 1, &vp);
+    ID3D11DeviceContext1_IASetPrimitiveTopology(context1, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext1_VSSetShader(context1, blitter.vs, NULL, 0);
+    ID3D11DeviceContext1_PSSetShader(context1, blitter.ps[needs_linear_output(dst_desc.Format)], NULL, 0);
+    ID3D11DeviceContext1_PSSetShaderResources(context1, 0, 1, &blitter.srv);
+    ID3D11DeviceContext1_PSSetSamplers(context1, 0, 1, &blitter.sampler);
+    ID3D11DeviceContext1_Draw(context1, 3, 0);
+    ID3D11DeviceContext1_PSSetShaderResources(context1, 0, 1, &null_srv);
+    ID3D11DeviceContext1_OMSetRenderTargets(context1, 0, NULL, NULL);
+
+    ID3D11DeviceContext1_SwapDeviceContextState(context1, prev, NULL);
+    if (prev) ID3DDeviceContextState_Release(prev);
+    ID3D11DeviceContext1_Release(context1);
+}
+
+/* ---------------- producer: the composition swapchain ---------------- */
+
+static BOOL update_shared_copy(struct mirror *m, ID3D11Device *device, ID3D11DeviceContext *context,
+        ID3D11Texture2D *src)
+{
+    D3D11_TEXTURE2D_DESC src_desc, desc;
+
+    ID3D11Texture2D_GetDesc(src, &src_desc);
+    if (m->shared_src)
+    {
+        ID3D11Texture2D_GetDesc(m->shared_src, &desc);
+        if (desc.Width != src_desc.Width || desc.Height != src_desc.Height || desc.Format != src_desc.Format)
+        {
+            EnterCriticalSection(&mirror_cs);
+            ID3D11Texture2D_Release(m->shared_src);
+            m->shared_src = NULL;
+            m->shared_handle = NULL;
+            LeaveCriticalSection(&mirror_cs);
+        }
+    }
+
+    if (!m->shared_src)
+    {
+        ID3D11Texture2D *texture = NULL;
+        IDXGIResource *resource = NULL;
+        HANDLE handle = NULL;
+        HRESULT hr;
+
+        memset(&desc, 0, sizeof(desc));
+        desc.Width = src_desc.Width;
+        desc.Height = src_desc.Height;
+        desc.MipLevels = 1;
+        desc.ArraySize = 1;
+        desc.Format = src_desc.Format;
+        desc.SampleDesc.Count = 1;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+        desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+        hr = ID3D11Device_CreateTexture2D(device, &desc, NULL, &texture);
+        if (SUCCEEDED(hr)) hr = ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIResource, (void **)&resource);
+        if (SUCCEEDED(hr)) hr = IDXGIResource_GetSharedHandle(resource, &handle);
+        if (resource) IDXGIResource_Release(resource);
+        TRACE("Mirror %p, shared texture %ux%u format %#x, hr %#lx, handle %p.\n", m,
+                desc.Width, desc.Height, desc.Format, hr, handle);
+        if (FAILED(hr) || !handle)
+        {
+            ERR("Failed to create shared texture, hr %#lx.\n", hr);
+            if (texture) ID3D11Texture2D_Release(texture);
+            return FALSE;
+        }
+        EnterCriticalSection(&mirror_cs);
+        m->shared_src = texture;
+        m->shared_handle = handle;
+        LeaveCriticalSection(&mirror_cs);
+    }
+
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)m->shared_src, (ID3D11Resource *)src);
+    ID3D11DeviceContext_Flush(context);
+    return TRUE;
+}
+
+static void on_source_present(struct mirror *m, IDXGISwapChain *swapchain)
+{
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *src;
+    ID3D11Device *device;
+
+    if (m->failed || !IsWindowVisible(m->target)) return;
+    if (FAILED(IDXGISwapChain_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&src))) return;
+    ID3D11Texture2D_GetDevice(src, &device);
+    ID3D11Device_GetImmediateContext(device, &context);
+    if (!update_shared_copy(m, device, context, src))
+        m->failed = TRUE;
+    m->last_tick = GetTickCount();
+    if (!(m->frames++ % 600))
+        TRACE("Mirror %p, %u source frames, %u composited.\n", m, m->frames, m->composited);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(device);
+    ID3D11Texture2D_Release(src);
+}
+
+/* ---------------- consumer: the window's own swapchain ---------------- */
+
+static void composite_into(IDXGISwapChain *swapchain)
+{
+    ID3D11Texture2D *dst = NULL, *src;
+    D3D11_TEXTURE2D_DESC src_desc, dst_desc;
+    ID3D11DeviceContext *context;
+    struct mirror *m = NULL, *cur;
+    ID3D11Device *device;
+    HANDLE handle = NULL;
+    HWND hwnd, root;
+    DWORD now;
+
+    if (FAILED(IDXGISwapChain1_GetHwnd((IDXGISwapChain1 *)swapchain, &hwnd)) || !hwnd) return;
+    root = GetAncestor(hwnd, GA_ROOT);
+    now = GetTickCount();
+
+    EnterCriticalSection(&mirror_cs);
+    LIST_FOR_EACH_ENTRY(cur, &mirrors, struct mirror, entry)
+    {
+        if (cur->failed || !cur->shared_handle || now - cur->last_tick > 1000) continue;
+        if (GetAncestor(cur->target, GA_ROOT) != root || !IsWindowVisible(cur->target)) continue;
+        m = cur;
+        handle = cur->shared_handle;
+        break;
+    }
+    LeaveCriticalSection(&mirror_cs);
+    if (!m) return;
+
+    if (FAILED(IDXGISwapChain_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&dst))) return;
+    ID3D11Texture2D_GetDevice(dst, &device);
+
+    if (m->opened_handle != handle)
+    {
+        HRESULT hr;
+
+        if (m->shared_dst) ID3D11Texture2D_Release(m->shared_dst);
+        m->shared_dst = NULL;
+        hr = ID3D11Device_OpenSharedResource(device, handle, &IID_ID3D11Texture2D, (void **)&m->shared_dst);
+        TRACE("Mirror %p, opened shared handle %p on device %p, hr %#lx.\n", m, handle, device, hr);
+        m->opened_handle = handle;
+        if (FAILED(hr))
+        {
+            ERR("Failed to open shared texture, hr %#lx.\n", hr);
+            m->shared_dst = NULL;
+            m->failed = TRUE;
+        }
+    }
+
+    if ((src = m->shared_dst))
+    {
+        ID3D11Device_GetImmediateContext(device, &context);
+        ID3D11Texture2D_GetDesc(src, &src_desc);
+        ID3D11Texture2D_GetDesc(dst, &dst_desc);
+        if (src_desc.Width == dst_desc.Width && src_desc.Height == dst_desc.Height
+                && src_desc.Format == dst_desc.Format && dst_desc.SampleDesc.Count == 1)
+            ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)dst, (ID3D11Resource *)src);
+        else
+            blit(device, context, src, dst);
+        if (!(m->composited++ % 600))
+            TRACE("Mirror %p, composited %u frames into swapchain %p, hwnd %p.\n", m, m->composited, swapchain, hwnd);
+        ID3D11DeviceContext_Release(context);
+    }
+
+    ID3D11Device_Release(device);
+    ID3D11Texture2D_Release(dst);
+}
+
+/* ---------------- present hooks ---------------- */
+
+/* Returns TRUE if the real Present must be skipped: DXVK would only present a
+ * composition swapchain to a hidden dummy window. */
+static BOOL on_present(IDXGISwapChain *swapchain, UINT flags)
+{
+    struct mirror *m;
+    BOOL skip;
+
+    if (flags & DXGI_PRESENT_TEST) return FALSE;
+
+    EnterCriticalSection(&mirror_cs);
+    m = find_mirror(swapchain);
+    skip = m && m->skip_present;
+    LeaveCriticalSection(&mirror_cs);
+
+    if (m)
+    {
+        on_source_present(m, swapchain);
+        return skip;
+    }
+
+    composite_into(swapchain);
+    window_present_tid = GetCurrentThreadId();
+    SetEvent(window_present_event);
+    return FALSE;
+}
+
+/* Run the producer in lockstep with the window's presents, one composition
+ * frame per window frame, instead of spinning or beating against it. */
+static void pace_skipped_present(void)
+{
+    if (window_present_tid == GetCurrentThreadId()) return;
+    WaitForSingleObject(window_present_event, 50);
+}
+
+static HRESULT STDMETHODCALLTYPE hook_present(IDXGISwapChain *swapchain, UINT sync_interval, UINT flags)
+{
+    if (on_present(swapchain, flags))
+    {
+        pace_skipped_present();
+        return S_OK;
+    }
+    return orig_present(swapchain, sync_interval, flags);
+}
+
+static HRESULT STDMETHODCALLTYPE hook_present1(IDXGISwapChain1 *swapchain, UINT sync_interval, UINT flags,
+        const DXGI_PRESENT_PARAMETERS *params)
+{
+    if (on_present((IDXGISwapChain *)swapchain, flags))
+    {
+        pace_skipped_present();
+        return S_OK;
+    }
+    return orig_present1(swapchain, sync_interval, flags, params);
+}
+
+static void patch_vtable(void **vtbl, unsigned int idx, void *func, void **orig)
+{
+    DWORD old;
+
+    if (vtbl[idx] == func) return;
+    VirtualProtect(&vtbl[idx], sizeof(void *), PAGE_READWRITE, &old);
+    *orig = vtbl[idx];
+    vtbl[idx] = func;
+    VirtualProtect(&vtbl[idx], sizeof(void *), old, &old);
+}
