+/* The swapchain implementation is shared by all swapchains of the process,
+ * so this also catches the presents of the window that hosts the target. */
+static void hook_swapchain(IDXGISwapChain1 *swapchain)
+{
+    void **vtbl = *(void ***)swapchain;
+
+    patch_vtable(vtbl, FIELD_OFFSET(IDXGISwapChain1Vtbl, Present) / sizeof(void *),
+            hook_present, (void **)&orig_present);
+    patch_vtable(vtbl, FIELD_OFFSET(IDXGISwapChain1Vtbl, Present1) / sizeof(void *),
+            hook_present1, (void **)&orig_present1);
+}
+
+static void attach_mirror(IUnknown *content, HWND target)
+{
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    IDXGISwapChain1 *swapchain;
+    struct mirror *m;
+
+    if (!content || FAILED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain1, (void **)&swapchain)))
+    {
+        FIXME("Unsupported content %p.\n", content);
+        return;
+    }
+    IDXGISwapChain1_GetDesc1(swapchain, &desc);
+
+    EnterCriticalSection(&mirror_cs);
+    if (!window_present_event) window_present_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if ((m = find_mirror(swapchain)))
+    {
+        m->target = target;
+        IDXGISwapChain1_Release(swapchain);
+    }
+    else if ((m = calloc(1, sizeof(*m))))
+    {
+        TRACE("Swapchain %p, %ux%u, format %#x, alpha %u, flags %#x, target %p.\n", swapchain,
+                desc.Width, desc.Height, desc.Format, desc.AlphaMode, desc.Flags, target);
+        m->src = swapchain;
+        m->target = target;
+        /* a waitable-object swapchain needs real presents to signal its waitable */
+        m->skip_present = !(desc.Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT);
+        list_add_tail(&mirrors, &m->entry);
+        hook_swapchain(swapchain);
+    }
+    else
+    {
+        IDXGISwapChain1_Release(swapchain);
+    }
+    LeaveCriticalSection(&mirror_cs);
+}
+
+static void detach_mirror(IUnknown *content)
+{
+    IDXGISwapChain1 *swapchain;
+    struct mirror *m;
+
+    if (!content || FAILED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain1, (void **)&swapchain)))
+        return;
+    EnterCriticalSection(&mirror_cs);
+    if ((m = find_mirror(swapchain)))
+    {
+        TRACE("Swapchain %p, mirror %p, %u frames, %u composited.\n", swapchain, m, m->frames, m->composited);
+        list_remove(&m->entry);
+        IDXGISwapChain1_Release(m->src);
+        /* the mirror itself is leaked on purpose, other threads may still use it */
+    }
+    LeaveCriticalSection(&mirror_cs);
+    IDXGISwapChain1_Release(swapchain);
+}
