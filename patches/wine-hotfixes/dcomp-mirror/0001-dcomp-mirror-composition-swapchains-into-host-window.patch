+static HRESULT STDMETHODCALLTYPE visual_RemoveVisual(IDCompositionVisual *iface, IDCompositionVisual *child)
+{
+    struct visual *visual = impl_from_IDCompositionVisual(iface);
+    unsigned int i;
+
+    TRACE("iface %p, child %p.\n", iface, child);
+
+    for (i = 0; i < visual->child_count; ++i)
+    {
+        if (&visual->children[i]->IDCompositionVisual_iface != child) continue;
+        IDCompositionVisual_Release(child);
+        memmove(&visual->children[i], &visual->children[i + 1], (visual->child_count - i - 1) * sizeof(*visual->children));
+        --visual->child_count;
+        return S_OK;
+    }
+    return E_INVALIDARG;
+}
